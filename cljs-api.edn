                                            :lines [125 204],
                                            :url "https://github.com/clojure/clojurescript/blob/r1.12.145/src/main/clojure/cljs/repl/node.clj#L125-L204"},
                                   :usage ["(setup repl-env)"
                                           "(setup {:keys [host port socket state], :as repl-env} opts)"],
                                   :full-name "cljs.repl.node/setup"},
