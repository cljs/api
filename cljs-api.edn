                                 :full-name-encode "cljs.core/tree-seq",
                                 :source {:code "(defn tree-seq\n  [branch? children root]\n   (let [walk (fn walk [node]\n                (lazy-seq\n                 (cons node\n                  (when (branch? node)\n                    (mapcat walk (children node))))))]\n     (walk root)))",
