                                      :full-name "cljs.repl.browser/setup"},
           "cljs.core/TransientHashMap" {:edit-url "https://github.com/cljs/api/blob/master/docfiles/cljs.core/TransientHashMap.md",
                                         :protocols #{"IFn"
                                                      "ITransientCollection"
                                                      "ICounted"
