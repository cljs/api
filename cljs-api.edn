                             :full-name-encode "cljs.core/aset",
                             :source {:code "(defn aset\n  ([array idx val]\n    (cljs.core/aset array idx val))\n  ([array idx idx2 & idxv]\n    (apply aset (aget array idx) idx2 idxv)))",
