                              :extra-sources ({:code "(defmethod emit* :throw\n  [{throw :exception :keys [env]}]\n  (if (= :expr (:context env))\n    (emits (iife-open env) \"throw \" throw (iife-close env))\n    (emitln \"throw \" throw \";\")))",
