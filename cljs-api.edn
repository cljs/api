                             :extra-sources ({:code "(core/defmacro list\n  ([]\n   '(.-EMPTY cljs.core/List))\n  ([x]\n   `(cljs.core/List. nil ~x nil 1 nil))\n  ([x & xs]\n   (core/let [cnt (core/inc (count xs))]\n     `(cljs.core/List. nil ~x (list ~@xs) ~cnt nil))))",
