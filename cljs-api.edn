                                :full-name-encode "cljs.core/areduce",
                                :source {:code "(core/defmacro areduce\n  [a idx ret init expr]\n  `(let [a# ~a\n         l# (alength a#)]\n     (loop  [~idx 0 ~ret ~init]\n       (if (< ~idx l#)\n         (recur (inc ~idx) ~expr)\n         ~ret))))",
                                         :title "Source code",
