                                         :full-name-encode "cljs.spec.alpha/multi-spec",
                                         :source {:code "(defmacro multi-spec\n  [mm retag]\n  `(multi-spec-impl '~(res &env mm) (var ~mm) ~retag))",
                                                  :title "Source code",
                                                  :repo "clojurescript",
