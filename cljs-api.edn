           "cljs.core/isa?" {:edit-url "https://github.com/cljs/api/blob/master/docfiles/cljs.core/isaQMARK.md",
                             :return-type boolean,
                             :ns "cljs.core",
                             :name "isa?",
                             :signature ["[child parent]"
                                         "[h child parent]"],
                             :name-encode "isaQMARK",
                             :history [["+" "0.0-927"]],
                             :type "function",
                             :clj-equiv {:full-name "clojure.core/isa?",
                                         :url "http://clojure.github.io/clojure/branch-master/clojure.core-api.html#clojure.core/isa?"},
                             :full-name-encode "cljs.core/isaQMARK",
                             :source {:code "(defn ^boolean isa?\n  ([child parent] (isa? @(get-global-hierarchy) child parent))\n  ([h child parent]\n   (or (= child parent)\n       (and (js-fn? parent) (js-fn? child)\n            (instance? parent child))\n       (contains? ((:ancestors h) child) parent)\n       (and (js-fn? child) (some #(contains? ((:ancestors h) %) parent) (supers child)))\n       (and (vector? parent) (vector? child)\n            (== (count parent) (count child))\n            (loop [ret true i 0]\n              (if (or (not ret) (== i (count parent)))\n                ret\n                (recur (isa? h (child i) (parent i)) (inc i))))))))",
                                      :title "Source code",
                                      :repo "clojurescript",
                                      :tag "r1.12.145",
                                      :filename "src/main/cljs/cljs/core.cljs",
                                      :lines [11290 11308],
                                      :url "https://github.com/clojure/clojurescript/blob/r1.12.145/src/main/cljs/cljs/core.cljs#L11290-L11308"},
                             :usage ["(isa? child parent)"
                                     "(isa? h child parent)"],
                             :full-name "cljs.core/isa?",
                             :see-also ["cljs.core/ancestors"
                                        "cljs.core/descendants"
                                        "cljs.core/make-hierarchy"
                                        "cljs.core/derive"],
                             :docstring "Returns true if (= child parent), or child is directly or indirectly derived from\nparent, either via a JavaScript type inheritance relationship or a\nrelationship established via derive. h must be a hierarchy obtained\nfrom make-hierarchy, if not supplied defaults to the global\nhierarchy"},
