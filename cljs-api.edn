           "cljs.core/UUID" {:edit-url "https://github.com/cljs/api/blob/master/docfiles/cljs.core/UUID.md",
                             :md-biblio #{"syntax/uuid-literal"
                                          "cljs.core/uuid"},
                             :protocols #{"IUUID"
                                          "IHash"
                                          "IComparable"
                                          "IPrintWithWriter"
                                          "IEquiv"},
                             :ns "cljs.core",
                             :name "UUID",
