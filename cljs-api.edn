           "cljs.spec.alpha/multi-spec" {:edit-url "https://github.com/cljs/api/blob/master/docfiles/cljs.spec.alpha/multi-spec.md",
                                         :ns "cljs.spec.alpha",
                                         :name "multi-spec",
