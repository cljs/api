                             :full-name-encode "cljs.core/aget",
                             :source {:code "(defn aget\n  ([array idx]\n     (cljs.core/aget array idx))\n  ([array idx & idxs]\n     (apply aget (aget array idx) idxs)))",
                                      :title "Function code",
