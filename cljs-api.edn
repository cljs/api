                             :full-name-encode "cljs.core/doto",
                             :source {:code "(core/defmacro doto\n  [x & forms]\n  (core/let [gx (gensym)]\n    `(let [~gx ~x]\n       ~@(map (core/fn [f]\n                (if (seq? f)\n                  `(~(first f) ~gx ~@(next f))\n                  `(~f ~gx)))\n           forms)\n       ~gx)))",
                                      :title "Source code",
