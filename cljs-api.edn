           "cljs.core/m3-hash-unencoded-chars" {:edit-url "https://github.com/cljs/api/blob/master/docfiles/cljs.core/m3-hash-unencoded-chars.md",
                                                :return-type number,
                                                :ns "cljs.core",
                                                :name "m3-hash-unencoded-chars",
