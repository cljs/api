                             :full-name-encode "cljs.core/as-GT",
                             :source {:code "(defmacro as->\n  {:added \"1.5\"}\n  [expr name & forms]\n  `(let [~name ~expr\n         ~@(interleave (repeat name) (butlast forms))]\n     ~(if (empty? forms)\n        name\n        (last forms))))",
